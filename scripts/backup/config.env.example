# Copy to state/backup/config.env and adjust as needed.
WORKSPACE_ROOT="/opt/fnos-media/services/openclaw/home/.openclaw/workspace"
BACKUP_ROOT="/mnt/nas/backup"
STAGING_ROOT="/opt/fnos-media/services/openclaw/home/.openclaw/workspace/state/backup/staging"
RUN_ARCHIVE=0
RETENTION_WEEKLY=12
PVE_ENABLED=1
PVE_SSH_HOST="192.168.1.190"
PVE_SSH_USER="root"
PVE_SSH_PASSWORD=""
FNOS_ENABLED=1
FNOS_LOCAL_ROOT="/opt/fnos-media"

GITHUB_SYNC_ENABLED=1
GITHUB_SYNC_REMOTE="git@github.com:wpp9527/fnos-rebuild-recovery.git"
GITHUB_SYNC_DST="/tmp/fnos-rebuild-recovery-export"
GITHUB_SYNC_BRANCH="main"
GITHUB_SYNC_GIT_NAME="wpp9527"
GITHUB_SYNC_GIT_EMAIL="wangpengpeng9527@gmail.com"

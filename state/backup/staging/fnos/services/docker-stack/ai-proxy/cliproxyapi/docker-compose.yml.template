services:
  cliproxyapi:
    image: ghcr.io/router-for-me/cliproxyapi:latest
    container_name: cliproxyapi
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "0.0.0.0:${CLIPROXYAPI_PORT:-8317}:8317"
    volumes:
      - ./config.yaml:/app/config.yaml
      - ./auths:/app/auths
      - ./logs:/app/logs

# CLIProxyAPI runtime env example
# Fill locally later. Do not commit real values.

CLIPROXYAPI_BIND_HOST=0.0.0.0
CLIPROXYAPI_PORT=8317
CLIPROXYAPI_EXPOSE_MODE=local-only

# Choose actual routing later:
CLIPROXYAPI_ENABLE_OPENAI=true
CLIPROXYAPI_ENABLE_CLAUDE=true
CLIPROXYAPI_ENABLE_GEMINI=true
CLIPROXYAPI_ENABLE_QWEN=true
CLIPROXYAPI_ENABLE_CODEX=true

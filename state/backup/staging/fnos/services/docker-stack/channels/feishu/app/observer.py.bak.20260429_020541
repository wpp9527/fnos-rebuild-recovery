import os
import time
import json
import subprocess
from pathlib import Path
import requests
import lark_oapi as lark
from lark_oapi.api.im.v1 import *

APP_ID = os.environ["FEISHU_APP_ID"]
APP_SECRET = os.environ["FEISHU_APP_SECRET"]
TARGET_OPEN_ID = os.environ["TARGET_OPEN_ID"]
DOMAIN = "https://open.larksuite.com"

def normalize_base(url: str) -> str:
    url = (url or "").strip().rstrip("/")
    if url.endswith("/v1"):
        url = url[:-3]
    return url

OPENCLAW_API_BASE = normalize_base(
    os.environ.get("OPENCLAW_API_BASE")
    or os.environ.get("OPENAI_API_BASE")
    or os.environ.get("OPENAI_BASE_URL")
    or os.environ.get("OPENCLAW_BASE_URL")
    or os.environ.get("OPENCLAW_GATEWAY_URL")
)
OPENCLAW_API_KEY = os.environ["OPENCLAW_API_KEY"]
OPENCLAW_MODEL = os.environ.get("OPENCLAW_MODEL", "openclaw/default")
TRUTH_HELPER = "/opt/fnos-media/services/openclaw-governance/scripts/runtime_truth_reply.py"

LOG_DIR = Path("/app/logs")
LOG_DIR.mkdir(parents=True, exist_ok=True)
ALL_LOG = LOG_DIR / "feishu-events.log"
REPLY_LOG = LOG_DIR / "feishu-reply.log"
OPENCLAW_LOG = LOG_DIR / "feishu-openclaw.log"
DEDUP_FILE = LOG_DIR / "processed-message-ids.json"

def write_line(path: Path, text: str):
    with path.open("a", encoding="utf-8") as f:
        f.write(text + "\n")

def load_seen():
    if not DEDUP_FILE.exists():
        return []
    try:
        return json.loads(DEDUP_FILE.read_text(encoding="utf-8"))
    except Exception:
        return []

def save_seen(items):
    DEDUP_FILE.write_text(json.dumps(items[-500:], ensure_ascii=False), encoding="utf-8")

def already_seen(msg_id: str) -> bool:
    return msg_id in load_seen()

def mark_seen(msg_id: str):
    items = load_seen()
    if msg_id not in items:
        items.append(msg_id)
        save_seen(items)

def get_tenant_access_token() -> str:
    r = requests.post(
        f"{DOMAIN}/open-apis/auth/v3/tenant_access_token/internal",
        headers={"Content-Type": "application/json; charset=utf-8"},
        json={"app_id": APP_ID, "app_secret": APP_SECRET},
        timeout=20,
    )
    r.raise_for_status()
    token = r.json().get("tenant_access_token", "")
    if not token:
        raise RuntimeError("no tenant_access_token")
    return token

def send_text_to_open_id(open_id: str, text: str):
    token = get_tenant_access_token()
    payload = {"receive_id": open_id, "msg_type": "text", "content": json.dumps({"text": text}, ensure_ascii=False)}
    r = requests.post(
        f"{DOMAIN}/open-apis/im/v1/messages?receive_id_type=open_id",
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json; charset=utf-8"},
        json=payload,
        timeout=20,
    )
    write_line(REPLY_LOG, f"{time.strftime('%F %T')} status={r.status_code} send_to={open_id}")
    write_line(REPLY_LOG, r.text)

def try_truth_first(user_text: str) -> str:
    try:
        out = subprocess.check_output([TRUTH_HELPER, user_text], text=True, timeout=5).strip()
        return out
    except Exception as e:
        write_line(OPENCLAW_LOG, f"{time.strftime('%F %T')} truth_first_error={repr(e)}")
        return ""

def build_system_prompt() -> str:
    return (
        "你是飞书入口中的太子代理，当前用户固定称呼为‘皇上’。"
        "默认使用中文回复，必要技术术语保留英文。"
        "回复风格默认简洁直接，复杂问题再展开，控制在 6 句内。"
        "低风险请求直接处理，高风险或敏感变更先确认。"
        "有已知偏好时，不要声称不知道皇上的偏好，也不要反问该如何称呼。"
        "敏感或秘密信息不得自动记忆。"
    )


def ask_openclaw(user_text: str) -> str:
    payload = {"model": OPENCLAW_MODEL, "messages": [{"role": "system", "content": build_system_prompt()}, {"role": "user", "content": user_text}]}
    r = requests.post(
        f"{OPENCLAW_API_BASE}/v1/chat/completions",
        headers={"Authorization": f"Bearer {OPENCLAW_API_KEY}", "Content-Type": "application/json"},
        json=payload,
        timeout=90,
    )
    write_line(OPENCLAW_LOG, f"{time.strftime('%F %T')} status={r.status_code}")
    write_line(OPENCLAW_LOG, r.text)
    r.raise_for_status()
    return r.json()["choices"][0]["message"]["content"].strip()

def do_p2_im_message_receive_v1(data: P2ImMessageReceiveV1) -> None:
    raw = lark.JSON.marshal(data, indent=2)
    write_line(ALL_LOG, raw)
    try:
        obj = json.loads(raw)
    except Exception:
        obj = {}
    sender_open_id = ((((obj.get("event") or {}).get("sender") or {}).get("sender_id") or {}).get("open_id", ""))
    msg_obj = ((obj.get("event") or {}).get("message") or {})
    message_id = msg_obj.get("message_id", "")
    message_content = msg_obj.get("content", "")
    try:
        user_text = (json.loads(message_content) if message_content else {}).get("text", "")
    except Exception:
        user_text = message_content or ""
    if sender_open_id != TARGET_OPEN_ID:
        return
    if message_id and already_seen(message_id):
        return
    if message_id:
        mark_seen(message_id)

    answer = try_truth_first(user_text)
    if not answer:
        try:
            answer = ask_openclaw(user_text if user_text else "请回复：收到")
        except Exception as e:
            answer = f"OpenClaw 调用失败：{repr(e)}"
    send_text_to_open_id(sender_open_id, answer[:3000] if answer else "空回复")

builder = lark.EventDispatcherHandler.builder("", "", lark.LogLevel.DEBUG)
builder = builder.register_p2_im_message_receive_v1(do_p2_im_message_receive_v1)
handler = builder.build()
client = lark.ws.Client(APP_ID, APP_SECRET, event_handler=handler, log_level=lark.LogLevel.DEBUG, domain=DOMAIN)
if __name__ == "__main__":
    client.start()

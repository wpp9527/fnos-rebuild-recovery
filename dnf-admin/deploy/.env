# DNF Admin Pro - 默认环境变量配置
# 复制此文件为 .env 并修改配置

# 服务器端口
SERVER_PORT=8080

# 默认区服配置
SERVER_ID=server1
SERVER_NAME=主区

# 数据库连接（默认区服）
DB_HOST=100.71.173.105
DB_PORT=3000
DB_NAME=d_taiwan
DB_USER=root
DB_PASSWORD=guoshengkai373

# JWT 密钥（请修改为随机字符串）

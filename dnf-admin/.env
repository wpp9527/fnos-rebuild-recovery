# DNF Admin Pro 配置
# 服务器配置
SERVER_ID=local
SERVER_NAME=本地区

# 数据库配置（主连接）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=${DNF_DB_ROOT_PASSWORD}
DB_NAME=d_taiwan

# JWT 密钥
JWT_SECRET=dnf-admin-secret-key-change-this

# 服务器端口
SERVER_PORT=18882

# 多服务器配置文件路径
SERVERS_CONFIG=multi-server/servers.json

# 日志级别
LOG_LEVEL=info
